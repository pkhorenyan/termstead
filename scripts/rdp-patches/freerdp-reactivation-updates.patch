+
+/* Termstead: xrdp starts drawing again before the client has finished the
+ * finalization of a deactivation-reactivation (a resize), and the strict
+ * check below ended the session about one time in two. The desktop already
+ * has its new size by then (DesktopResize runs before finalization), so
+ * those updates are drawn instead. */
+static BOOL update_may_receive(rdpRdp* rdp)
+{
+	if (rdp->was_deactivated && (rdp_get_state(rdp) >= CONNECTION_STATE_FINALIZATION_SYNC))
+		return TRUE;
+	return rdp_has_reached_state(rdp, CONNECTION_STATE_ACTIVE);
 }
 
